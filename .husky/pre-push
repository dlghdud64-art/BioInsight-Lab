#!/bin/sh
# §lint-gate-restore + §em-dash-sweep (2026-09-10·11) — **신규 추가 파일만** 검사.
#   레거시(eslint 5,820건 · em dash 6,926건)는 대상이 아니다.
#   새로 만드는 코드만 clean 을 강제한다. 일괄 치환·--fix 금지.
#   범위는 이번 push 가 싣는 커밋 전량(@{u}..HEAD)이라 병렬 세션의 신규 파일도 함께 걸린다
#   (push 는 브랜치 단위라 그게 정확한 범위다 — §병렬 세션 3).
#   파일 목록은 1회만 계산해 두 검사가 공유한다.
if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  added=$(git diff --name-only --diff-filter=A '@{u}..HEAD' -- apps/web/src \
            | grep -E '\.(ts|tsx)$')
  if [ -n "$added" ]; then
    echo "── 신규 파일 $(echo "$added" | grep -c .)개 검사"
    ( cd apps/web && echo "$added" | sed 's|^apps/web/||' | xargs npx eslint ) || exit 1
    echo "$added" | xargs npx tsx scripts/check-em-dash-new-files.ts || exit 1
  fi
fi
cd apps/web && npm run build || exit 1
