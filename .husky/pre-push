#!/bin/sh
# pre-push — **무거운 게이트만** 남긴다.
#
# §gate-to-pre-commit (호영님 2026-09-11) — 신규 파일 eslint · em dash 검사는 pre-commit 으로 옮겼다.
#   여기서는 그 검사가 구조적으로 무력했다: 공유 워킹트리에서 A 세션 커밋을 B 세션이 push 하면
#   A 의 pre-push 는 돌지 않는다(2026-09-11 실측 · 2c398691 이 em dash 를 실은 채 원격 도착).
#   커밋 시점에 걸면 누가 push 하든 게이트를 통과한 커밋만 존재한다.
#
# build 는 파일 단위로 판정할 수 없어(워킹트리 전체 · 타입 · export) 여기 남는다.
cd apps/web && npm run build || exit 1
