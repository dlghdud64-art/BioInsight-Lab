#!/usr/bin/env sh
#
# LabAxis commit-msg hook (§commit-footer-gate · 호영님 판정 2026-08-26)
# ─────────────────────────────────────────────────────────────────────
# CLAUDE.md "Commit Convention" 의 footer 조항을 강제한다:
#
#   footer: 없음 (Anthropic Co-Authored-By 사용 금지 — 호영님 통제 구조)
#
# 왜 훅이 필요한가 (2026-08-26 실측):
#   조항 도입 e1cb184f (2026-05-26) 이후 200커밋은 위반 0 이었다.
#   그런데 2026-08-20 부터 갑자기 붙기 시작해 최근 100커밋 중 52건,
#   최근 30커밋 중 20건이 위반이다. 사무국(Cowork)의 기본 커밋 문법이
#   footer 를 붙이는데, 이 저장소 조항이 그것을 금지한다.
#
#   🔑 sentinel 40건 · pre-commit · pre-push · tsc 어느 것도 커밋 메시지
#      형식을 보지 않는다. 게이트가 안 보는 조항은 6일이면 조용히 무너진다.
#      계수가 쉬운 조항이므로 게이트를 붙일 수 있는 자리다.
#
# 이력 52건은 재작성하지 않는다 — 푸시된 이력 재작성이 더 나쁜 거래다.
# 이 훅은 **앞으로만** 막는다.

MSG_FILE="$1"

# 무엇을 막는가: **트레일러**다. 문자열이 아니다.
#
# 첫 판(2026-08-26)은 grep -qi 'Co-Authored-By' 로 문자열을 막았고, 자기 자신의
# 커밋 메시지에서 오탐이 났다 — 조항을 설명하는 산문에도 그 이름이 들어간다.
# (이 훅을 도입하는 커밋의 본문이 바로 그랬다.)
#
# 🔑 잠그는 결정은 "Co-Authored-By 트레일러가 없다" 이지 "그 이름이 안 나온다"
#    가 아니다. git 트레일러는 줄 맨 앞 + 콜론이므로 그 형태만 막는다.
#    이러면 조항을 논하는 커밋 메시지는 통과하고, 실제 트레일러만 거부된다.
#
# 주석 줄(#)은 커밋 메시지에서 제거되므로 먼저 걷어낸다.
if grep -v '^#' "$MSG_FILE" | grep -qiE '^Co-Authored-By[[:space:]]*:'; then
  echo ""
  echo "═══ 커밋 거부 — CLAUDE.md footer 조항 위반 ═══"
  echo ""
  echo "  커밋 메시지에 Co-Authored-By 가 있습니다."
  echo "  CLAUDE.md \"Commit Convention\":"
  echo "    footer: 없음 (Anthropic Co-Authored-By 사용 금지 — 호영님 통제 구조)"
  echo ""
  echo "  호영님이 코드/DB/터미널에 직접 접근하지 않고 모든 작업을 위임하는"
  echo "  구조라, 커밋의 저자 표기가 그 통제 구조를 흐리면 안 됩니다."
  echo ""
  echo "  해당 줄을 지우고 다시 커밋하십시오."
  echo ""
  exit 1
fi

exit 0
