#!/usr/bin/env sh
#
# LabAxis pre-commit hook
# ─────────────────────────────────
# §gate-to-pre-commit (호영님 2026-09-11) — **파일 단위 게이트를 커밋 시점으로 옮겼다.**
#   pre-push 는 push 하는 세션의 훅만 돈다. 공유 워킹트리에서는 A 세션이 만든 커밋을
#   B 세션이 push 하면 A 의 커밋은 아무 게이트도 거치지 않고 원격에 도착한다.
#   2026-09-11 실측: 2c398691 이 em dash 가 든 신규 테스트 파일을 실은 채 원격에 도착했다
#   (그 커밋을 만든 세션의 push 는 게이트에 막혔는데, 다른 push 에 먼저 실려 나갔다).
#   이건 도구 문제가 아니라 구조 문제다 — 커밋 생성 시점에 걸면 누가 push 하든
#   게이트를 통과한 커밋만 존재한다.
#   무거운 게이트(build)는 pre-push 에 남긴다. 파일 단위로 판정 가능한 것만 여기 둔다.
#
# ⚠️ husky 9 는 훅을 sh -e 로 돌린다. 파이프 끝 grep 이 매치 0이면 exit 1 → 훅이 조용히 죽는다.
#   그래서 목록 계산은 반드시 `|| true` 로 닫는다(2026-09-11 실측 · 60f80de7).
#
# History
#   §11.45  check-no-inline-hex-bg.sh 작성   §11.49  pre-commit 배선
#   §lint-gate-restore · §em-dash-sweep  pre-push 에 신규 파일 게이트 → §gate-to-pre-commit 로 이관

# ── 0. §gate-staged-vs-worktree (호영님 2026-09-12) — **검사 전제를 강제한다.**
#   검사기(eslint · em dash · hex)는 워킹트리 파일을 읽는다. 스테이징 후 파일을 더 고치면
#   검사한 판본과 커밋되는 판본이 다르다 — 게이트가 있는데 통과 근거가 다른 파일이 된다.
#   `git stash -k` 는 쓰지 않는다: 공유 워킹트리에서 남의 미커밋 변경까지 밀어낸다
#   (실측 사고 2회 · CLAUDE.md §병렬 세션 2). `git show :<path>` 추출은 eslint 의 @/ alias 해석이 깨진다.
#   → 검사기를 건드리지 않고 전제를 강제한다: 검사 대상에 한해 스테이징 = 워킹트리.
#   🛑 훅이 스테이징을 자동으로 고치지 않는다 — 일부만 의도적으로 스테이징했을 수 있다. 사람이 정한다.
gate_targets=$(git diff --cached --name-only --diff-filter=ACMRTUXB -- apps/web/src | grep -E '[.](ts|tsx)$' || true)
if [ -n "$gate_targets" ]; then
  drift=$(echo "$gate_targets" | xargs git diff --name-only -- 2>/dev/null || true)
  if [ -n "$drift" ]; then
    echo "🛑 스테이징 후 수정된 검사 대상 파일이 있습니다 · 검사 판본과 커밋 판본이 다릅니다:"
    echo "$drift" | sed 's/^/     /'
    echo "   git add 후 다시 커밋하십시오."
    exit 1
  fi
fi

# ── 1. 신규 추가 파일: eslint + em dash 구분자 (스테이징 기준) ──
#   위 0번이 스테이징 = 워킹트리를 보장하므로, 검사기가 워킹트리를 읽어도 판본이 같다(옛 한계 닫힘).
added=$(git diff --cached --name-only --diff-filter=A -- apps/web/src \
          | grep -E '\.(ts|tsx)$' || true)
if [ -n "$added" ]; then
  echo "── 신규 파일 $(echo "$added" | grep -c .)개 검사 (pre-commit)"
  ( cd apps/web && echo "$added" | sed 's|^apps/web/||' | xargs npx eslint ) || exit 1
  echo "$added" | xargs npx tsx scripts/check-em-dash-new-files.ts || exit 1
fi

# ── 2. dashboard 표면 inline hex 배경 (§11.49) ──
DASHBOARD_STAGED=$(git diff --cached --name-only --diff-filter=ACMRTUXB \
  | grep -E '^apps/web/src/app/dashboard/.*\.(ts|tsx)$' || true)
if [ -n "$DASHBOARD_STAGED" ]; then
  scripts/check-no-inline-hex-bg.sh || exit 1
fi
