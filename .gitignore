# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# 세션별 빌드 산출물 (NEXT_DIST_DIR · CLAUDE.md ## 병렬 세션)
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 값(.env / .env.local 등)은 절대 커밋 금지.
#   예시 파일(.env.example, 변수 이름만)은 커밋 허용(팀·Vercel 등록용 체크리스트).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# 삭제된 파일 (다시 추가 방지)
apps/web/public/brand/bioinsight-icon.PNG
apps/web/public/brand/bioinsight-icon.svg
.mcp.json

# Prisma migrations backup (pre-baseline consolidation)
apps/web/prisma/migrations.backup-*

# Claude Code sandbox artifacts (never commit)
.claude/worktrees/
tmpclaude-*-cwd
*.tsx.bak
*.ts.bak
*.bak

# LabAxis agent review generated reports
.labaxis/runs/*.md

# vitest full-suite baseline 산출물 (4MB, 재생성 가능 — 커밋 금지)
#   생성: vitest --reporter=json --outputFile=full-baseline.json
#   §money-path-coverage-restore 세션에서 실수 커밋 위험이 확인되어 ignore 등록.
apps/web/full-baseline.json
